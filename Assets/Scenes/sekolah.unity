  dataKuisBab:
  - namaBab: GEOGRGAFI
    kumpulanSoal:
    - teksSoal: Ilmu yang mempelajari permukaan bumi disebut...
      pilihanA: Geografi
      pilihanB: Ekonomi
      pilihanC: Sosiologi
      pilihanD: Sejarah
      jawabanBenar: A
    - teksSoal: Gunung, sungai, dan laut termasuk ...
      pilihanA: Fenomena sosial
      pilihanB: Fenomena alam
      pilihanC: Kegiatan ekonomi
      pilihanD: Budaya
      jawabanBenar: B
    - teksSoal: Letak suatu wilayah disebut ...
      pilihanA: Lokasi
      pilihanB: Distribusi
      pilihanC: Produksi
      pilihanD: Konsumsi
      jawabanBenar: A
    - teksSoal: Iklim dipengaruhi oleh ...
      pilihanA: Cuaca sesaat
      pilihanB: Kondisi jangka panjang
      pilihanC: Penduduk
      pilihanD: Teknologi
      jawabanBenar: B
    - teksSoal: Peta digunakan untuk ...
      pilihanA: Menghitung laba
      pilihanB: Menunjukkan lokasi
      pilihanC: Menentukan harga
      pilihanD: Meneliti budaya
      jawabanBenar: B
  - namaBab: EKONOMI
    kumpulanSoal:
    - teksSoal: Kegiatan menghasilkan barang disebut...
      pilihanA: Distribusi
      pilihanB: Produksi
      pilihanC: Konsumsi
      pilihanD: Investasi
      jawabanBenar: B
    - teksSoal: Orang yang menggunakan barang disebut ...
      pilihanA: Produsen
      pilihanB: Distributor
      pilihanC: Konsumen
      pilihanD: Investor
      jawabanBenar: C
    - teksSoal: Penyaluran barang dari produsen ke konsumen disebut...
      pilihanA: Distribusi
      pilihanB: Produksi
      pilihanC: Konsumsi
      pilihanD: Promosi
      jawabanBenar: A
    - teksSoal: Tujuan utama kegiatan ekonomi adalah ...
      pilihanA: Bermain
      pilihanB: Memenuhi kebutuhan hidup
      pilihanC: Berwisata
      pilihanD: Berolahraga
      jawabanBenar: B
    - teksSoal: ontoh kegiatan konsumsi adalah ...
      pilihanA: Membuat roti
      pilihanB: Menjual roti
      pilihanC: Memakan roti
      pilihanD: Mengirim roti
      jawabanBenar: C
